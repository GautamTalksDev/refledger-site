{
  "name": "refledger-site",
  "type": "module",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "fetch-data": "node scripts/fetch-data.mjs",
    "prebuild": "npm run fetch-data && node scripts/publish-verify-data.mjs && node scripts/generate-og.mjs",
    "dev": "npm run fetch-data && node scripts/publish-verify-data.mjs && astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:copy": "node scripts/check-copy-rules.mjs",
    "check:size": "node scripts/check-js-size.mjs",
    "check:pins": "node scripts/check-action-pins.mjs",
    "check:audit": "node scripts/check-audit.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "astro": "7.3.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.18.6",
    "axe-core": "4.13.0",
    "fast-check": "4.10.2",
    "parse5": "8.0.1",
    "sharp": "0.35.5",
    "typescript": "5.9.2",
    "vitest": "5.0.3"
  },
  "private": true
}
