---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Not found · Refledger"
  description="That page is not in the record."
>
  <div class="wrap narrow u-00e2e95c">
    <div
      class="mono u-9f500953"
     
    >
      404
    </div>
    <h1 class="h2 u-c2f8546b" tabindex="-1">No page here.</h1>
    <p class="lede u-1b0f4999">
      Unlike a moved tag, this is something we can say for certain.
    </p>
    <div class="row u-2fbbbcd4">
      <a href="/" class="btn b-blue">Check a repository</a>
      <a href="/moved" class="btn b-line">See what moved</a>
    </div>
  </div>
</BaseLayout>
