---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Not found · Refledger"
  description="That page is not in the record."
>
  <div class="wrap narrow" style="padding-top:96px">
    <div
      class="mono"
      style="font-size:clamp(110px,18vw,240px);line-height:.8;font-weight:700;letter-spacing:-.06em"
    >
      404
    </div>
    <h1 class="h2" tabindex="-1" style="margin-top:32px">No page here.</h1>
    <p class="lede" style="margin-top:16px">
      Unlike a moved tag, this is something we can say for certain.
    </p>
    <div class="row" style="margin-top:30px">
      <a href="/" class="btn b-blue">Check a repository</a>
      <a href="/moved" class="btn b-line">See what moved</a>
    </div>
  </div>
</BaseLayout>
