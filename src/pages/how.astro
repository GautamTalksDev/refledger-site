---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteData } from '../data';
import { buildIndex } from '../lib/api-v1';
import { fmtLedgerAsOf } from '../lib/format';
import type { HowPagePayload } from '../scripts/how-app';

const data = getSiteData();
const pop = buildIndex(data).population;
const genesisMs = new Date(data.genesisAt).getTime();
const nowMs = new Date(data.buildTime).getTime();
const totalHours = (nowMs - genesisMs) / 3_600_000;

function toHours(iso: string): number {
  return (new Date(iso).getTime() - genesisMs) / 3_600_000;
}

const wallRows = data.wallDefaultRepos.slice(0, 7);
const firstRepo = wallRows[0];

let firstRowMoveH: number | null = null;
if (firstRepo) {
  const moves = data.traceEvents
    .filter((e) => e.repo === firstRepo && !e.isCanary && e.event === 'move')
    .sort((a, b) => (a.recorded_at < b.recorded_at ? -1 : 1));
  if (moves.length) firstRowMoveH = toHours(moves[0].recorded_at);
}

let gapStartH: number | null = null;
let gapEndH: number | null = null;
let bestGap = 0;
for (const g of data.gapBands) {
  if (g.kind !== 'PollerDown' && g.label !== 'poller down') continue;
  const dur =
    new Date(g.end).getTime() - new Date(g.start).getTime();
  if (dur > bestGap) {
    bestGap = dur;
    gapStartH = toHours(g.start);
    gapEndH = toHours(g.end);
  }
}

const canaryDotHs = data.traceEvents
  .filter((e) => e.isCanary)
  .map((e) => toHours(e.recorded_at))
  .sort((a, b) => a - b);

const events: HowPagePayload['events'] = [{ h: 0, text: 'Genesis. Watching begins.' }];

for (const seal of data.seals) {
  const at =
    seal.head?.head.recorded_at ??
    `${seal.digest.observation_digest.date}T12:00:00.000Z`;
  events.push({ h: toHours(at), text: 'Day sealed and witnessed.' });
}

for (const g of data.gapBands) {
  if (g.kind === 'PollerDown' || g.label === 'poller down') {
    events.push({
      h: toHours(g.start),
      text: 'Our poller went down. The gap is recorded, not hidden.',
    });
    events.push({
      h: toHours(g.end),
      text: 'Back up. Missed moves recorded on recovery.',
    });
  }
}

for (const e of [...data.traceEvents].sort((a, b) =>
  a.recorded_at < b.recorded_at ? -1 : 1,
)) {
  const label = e.isCanary ? 'Canary test: ' : '';
  const what = e.whatChanged ?? e.event;
  events.push({
    h: toHours(e.recorded_at),
    text: `${label}${what.charAt(0).toLowerCase() + what.slice(1)} (${e.repo} ${e.tag}).`,
  });
}

events.push({ h: totalHours, text: 'Now.' });
events.sort((a, b) => a.h - b.h);

const payload: HowPagePayload = {
  genesisMs,
  nowMs,
  wallRows,
  events,
  gapStartH,
  gapEndH,
  firstRowMoveH,
  canaryDotHs,
  actionCount: pop.action_count,
  repositoryCount: pop.repository_count,
};

const tipSeq = Math.max(0, data.chainLength - 1);
---

<BaseLayout
  title="How it works · Refledger"
  description="Move a tag, watch the poller, and see how the signed hash chain works."
  canonicalPath="/how"
  nav="how"
  ledgerAsOf={fmtLedgerAsOf(data.buildTime)}
  latestSeq={tipSeq}
>
  <div class="wrap u-e47c4d83">
    <h1 class="h1" tabindex="-1">How it works.</h1>
    <p class="lede u-f18c99ec">
      Three things to try. Each one takes ten seconds, and each one is exactly what
      Refledger does.
    </p>

    <div class="ledgerrow u-a7fabf36" data-sec="1">
      <div class="stamp" data-stamp="1">
        <div class="n">1</div>
        <div class="h" data-prev></div>
        <div class="h me" data-hash></div>
      </div>
      <div>
        <h2 class="h2" data-text>A tag is a pointer. Go on, move it.</h2>
        <p class="lede u-72620200" data-text>
          This is the whole attack. It takes one second, and nothing in your repository
          changes.
        </p>
        <div class="card u-29c5a13b">
          <div class="grid12 u-45f762a6">
            <div class="span7 u-7a771566">
              <svg class="u-485d0844"
                viewBox="0 0 640 200"
               
                role="img"
                aria-live="polite"
                id="toy-svg"></svg>
            </div>
            <div class="span5 night u-8bbc7c46">
              <div class="lbl">Your next CI run</div>
              <div class="mono u-e6d3c8f1" id="toy-run">
              </div>
            </div>
          </div>
          <div
            class="row u-a1624566"
           
          >
            <p class="u-be3867d7" aria-live="polite" id="toy-msg">
            </p>
            <div class="row" id="toy-btns"></div>
          </div>
          <div class="u-d79f8cb5"
           
          >
            <div class="lbl">The ledger</div>
            <div class="u-d2c171b1" id="toy-ledger"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="ledgerrow u-41292ed0" data-sec="2">
      <div class="stamp" data-stamp="2">
        <div class="n">2</div>
        <div class="h" data-prev></div>
        <div class="h me" data-hash></div>
      </div>
      <div>
        <div
          class="row u-cf7968de"
         
        >
          <div>
            <h2 class="h2" data-text>We watch for it, every five minutes.</h2>
            <p class="lede u-72620200" data-text id="how-wall-lede">
            </p>
          </div>
          <div class="u-54c2afb7">
            <div class="lbl">Instrument clock, UTC</div>
            <div
              class="ins u-22f9ccf9"
              id="clock"
              aria-live="polite"
             
            >
            </div>
          </div>
        </div>
        <div class="card u-8b9f3101">
          <div
            class="scroll-x"
            id="wall"
            tabindex="0"
            role="region"
            aria-label="Watched actions over time"
          ></div>
          <div class="row u-56f43562">
            <button
              type="button"
              class="btn b-blue small u-4e509ff5"
              data-act="play"
              id="playbtn"
             >Play</button
            >
            <label for="scrub" class="lbl">Time</label>
            <input class="u-67ae35ac"
              id="scrub"
              type="range"
              min="0"
              max="100"
              step="0.25"
              value="100"
             
            />
            <span
              class="ins u-fa7ccc17"
              id="latest"
             ></span>
          </div>
        </div>
      </div>
    </div>

    <div class="ledgerrow u-41292ed0" data-sec="3">
      <div class="stamp" data-stamp="3">
        <div class="n">3</div>
        <div class="h" data-prev></div>
        <div class="h me" data-hash></div>
      </div>
      <div>
        <h2 class="h2" data-text>Every move is signed and chained.</h2>
        <p class="lede u-2c601711" data-text>
          Each entry includes the hash of the one before it. Change one byte anywhere,
          and every entry after it stops matching. That is why nobody, including us,
          can quietly rewrite the record.
        </p>
      </div>
    </div>

    <div class="ledgerrow u-41292ed0" data-sec="4">
      <div class="stamp" data-stamp="4">
        <div class="n">4</div>
        <div class="h" data-prev></div>
        <div class="h me" data-hash></div>
      </div>
      <div>
        <h2 class="h2" data-text>This page works the same way.</h2>
        <p class="lede u-2c601711" data-text>
          Look at the margin. Each section above is hashed with SHA-256 in your browser
          and chained to the one before. Edit any word and see where the chain breaks.
        </p>
        <div class="row u-24d308c0">
          <button type="button" class="btn b-ink" data-act="tamper" id="tamperbtn"
            >Change one word</button
          >
          <button
            type="button"
            class="btn b-line"
            data-act="editpage"
            id="editbtn"
            aria-pressed="false">Edit the page yourself</button
          >
        </div>
        <p
          class="ins u-2451ea3c"
          id="verdict"
          aria-live="polite"
         ></p>
      </div>
    </div>

    <section class="grid12 u-41292ed0">
      <div class="span7 card u-dbc9589a">
        <h2 class="h3">What we watch, and why</h2>
        <p class="u-a828a272" id="how-population"></p>
        <ul class="u-155ae14e">
          <li>Heavily used official actions from GitHub, AWS, Azure and others.</li>
          <li>Actions involved in real incidents.</li>
          <li>Everything those actions pull in themselves, at every tag.</li>
          <li>One canary of our own, moved on purpose to test the instrument.</li>
        </ul>
      </div>
      <div class="span5 night u-dbc9589a">
        <h2 class="h3 u-aa546bcc">Don't trust us. Check us.</h2>
        <p class="u-5abf8741">
          Replay the whole ledger in your browser, recompute every hash, and check every
          signature.
        </p>
        <a href="/verify" class="btn b-light u-a26bda7d">Verify the ledger</a>
      </div>
    </section>
  </div>

  <template id="how-payload">{JSON.stringify(payload)}</template>
  <script>
    import { bootHowPage } from '../scripts/how-app';
    const tpl = document.getElementById('how-payload') as HTMLTemplateElement | null;
    // Template children live in .content; template.textContent is empty.
    const payload = JSON.parse(tpl?.content?.textContent || '{}');
    bootHowPage(payload);
  </script>
</BaseLayout>
