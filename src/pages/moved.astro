---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteData } from '../data';
import {
  fmtLedgerAsOf,
  fmtUtc,
  severityClass,
  titleCaseSeverity,
} from '../lib/format';

const data = getSiteData();
const feed = data.traceEvents;
const ecoCount = feed.filter((r) => !r.isCanary).length;
const tipSeq = Math.max(0, data.chainLength - 1);

function hrefFor(ev: (typeof feed)[0]): string {
  if (ev.event === 'move' || ev.event === 'recreation') {
    return `/a/${ev.repo}/${ev.tag}`;
  }
  return `/e/${ev.seq}`;
}
---

<BaseLayout
  title="What moved · Refledger"
  description="Every tag move Refledger has recorded, newest first."
  canonicalPath="/moved"
  nav="moved"
  ledgerAsOf={fmtLedgerAsOf(data.buildTime)}
  latestSeq={tipSeq}
>
  <div class="wrap" style="padding-top:72px">
    <div
      class="row"
      style="justify-content:space-between;align-items:flex-end;gap:24px"
    >
      <div>
        <h1 class="h1" tabindex="-1">What moved.</h1>
        <p class="lede" style="margin-top:20px;max-width:640px">
          Every tag move we have recorded, newest first. The time is the check
          that first saw it. The real moment falls within the five minutes
          before.
        </p>
      </div>
      <a href="/moved.xml" class="btn b-line">Follow with RSS</a>
    </div>

    <div class="row" style="margin-top:36px">
      <a href="/moved" class="btn small b-ink" data-moved-tab="eco">Ecosystem</a>
      <a
        href="/moved?canary=1"
        class="btn small b-line"
        data-moved-tab="canary">Include canary tests</a
      >
      <span class="lbl" style="margin-left:6px" id="moved-count"></span>
    </div>

    <div class="feed" style="margin-top:22px" id="moved-feed">
      <div
        class="feedrow ins"
        style="font-size:12px;color:var(--ink3);padding-top:0;padding-bottom:0"
        aria-hidden="true"
      >
        <span>Seen, UTC</span>
        <span>Action and tag</span>
        <span>What changed</span>
        <span>From, to</span>
        <span>Severity</span>
      </div>
      {
        feed.map((r) => {
          const correction = data.correctionsBySeq.get(r.seq);
          const sev = titleCaseSeverity(r.severity);
          return (
            <a
              class="paper feedrow rise"
              href={hrefFor(r)}
              data-canary={r.isCanary ? '1' : '0'}
            >
              <span class="ins" style="font-size:14px">
                {fmtUtc(r.recorded_at)}
              </span>
              <span>
                <b>{r.repo}</b>{' '}
                <span class="mono" style="font-size:13px">
                  {r.tag}
                </span>
                {r.isCanary && (
                  <span class="pill" style="margin-left:4px">
                    Canary
                  </span>
                )}
              </span>
              <span style="color:var(--ink2)">
                {r.whatChanged ?? r.event}
                {correction && (
                  <span
                    class="ins"
                    style="display:block;margin-top:4px;font-size:12.5px;color:var(--rust)"
                  >
                    Corrected: the signed entry called this a content change. It
                    was not.
                  </span>
                )}
              </span>
              <span class="mono" style="font-size:13px">
                {r.fromToText ?? ''}
              </span>
              <span
                class:list={['ins', severityClass(r.severity)]}
                style="font-size:13px"
              >
                {sev}
              </span>
            </a>
          );
        })
      }
      <p
        class="ins muted"
        style="margin-top:8px;font-size:14px"
        data-canary-note
      >
        The canary is a repository of ours whose tags we move on purpose, every
        four hours, to prove we notice. <a href="/moved?canary=1">Show its moves</a>
      </p>
    </div>
  </div>

  <div id="moved-boot" hidden data-eco-count={String(ecoCount)}></div>
  <script>
    import { bootMovedFilter } from '../scripts/moved-filter';
    const eco = Number(
      document.getElementById('moved-boot')?.getAttribute('data-eco-count') ||
        '0',
    );
    bootMovedFilter(eco);
  </script>
</BaseLayout>
