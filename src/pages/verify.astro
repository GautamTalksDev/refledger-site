---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteData } from '../data';
import { PINNED_PUBKEY } from '../lib/verify';
import { fmtLedgerAsOf } from '../lib/format';

const data = getSiteData();
const entryCount = data.chainLength;
const tipSeq = Math.max(0, entryCount - 1);

const cli = `git clone https://github.com/GautamTalksDev/refledger.git
cd refledger
cargo run --locked --release -p refledger-verify -- data/log --strict \\
  --pubkey ${PINNED_PUBKEY}`;

const cliShort = `cargo run --locked --release -p refledger-verify -- data/log --strict --pubkey ${PINNED_PUBKEY}`;
---

<BaseLayout
  title="Verify the ledger · Refledger"
  description="Replay every entry, recompute every hash, and check every signature in your browser or with the CLI."
  canonicalPath="/verify"
  nav="verify"
  ledgerAsOf={fmtLedgerAsOf(data.lastCheckedAt)}
  ledgerAsOfIso={data.lastCheckedAt}
  latestSeq={tipSeq}
>
  <div class="wrap u-e47c4d83">
    <h1 class="h1" tabindex="-1">
      Don't trust us.<br /><span class="u-285582c7">Check us.</span>
    </h1>
    <p class="lede u-aa1a1fba">
      One click replays every entry in the ledger, recomputes every hash and checks every
      signature, in your browser. Nothing to install, nobody to trust.
    </p>
    <p class="lbl">
      Ledger data: CC0, public domain. Site code is Apache-2.0.{' '}
      <a
        href="https://github.com/GautamTalksDev/refledger/blob/main/DATA-LICENSE"
        rel="noopener noreferrer">Data license</a>.
    </p>

    <div class="night u-9c067595">
      <div class="row u-a562f4fd">
        <button type="button" class="btn b-light" data-act="verify" id="vbtn"
          >Verify the whole ledger</button
        >
        <span
          class="ins u-d67de6c9"
          id="vstatus"
          aria-live="polite"
         >{entryCount} entries ready.</span
        >
      </div>
      <div class="chain u-583f758b" aria-hidden="true" id="vchain"></div>
      <div id="vresult"></div>
    </div>

    <section class="grid12 u-a7fabf36">
      <div class="span5">
        <h2 class="h3">Prefer your own terminal?</h2>
        <p class="u-a828a272">
          The command line verifier shares no code with the program that writes the ledger.
          That is the point: two independent programs agreeing is evidence. One agreeing with
          itself is not.
        </p>
      </div>
      <div class="span7 paper u-10c6e7bb">
        <div class="row u-a562f4fd">
          <span class="lbl">From a clone of the repository</span>
          <button type="button" class="btn b-line small" data-act="copycli">Copy</button>
        </div>
        <pre
          class="mono u-9906a5fb"
         
          ><code id="cli">{cliShort}</code></pre
        >
      </div>
    </section>
  </div>

  <div
    id="verify-boot"
    hidden
    data-cli={cli}
    data-entry-count={String(entryCount)}
  ></div>
  <script>
    import {
      verifyLedger,
      PINNED_PUBKEY,
      ed25519Available,
    } from '../lib/verify';
    import { TILE_REVEAL_MS, revealImmediately } from '../lib/reveal';
    import { clearHTML, setHTML } from '../lib/trusted-html';

    const boot = document.getElementById('verify-boot');
    const fullCli = boot?.getAttribute('data-cli') || '';
    const entryCountBoot = Number(boot?.getAttribute('data-entry-count') || '0');

    const btn = document.getElementById('vbtn') as HTMLButtonElement | null;
    const status = document.getElementById('vstatus');
    const chain = document.getElementById('vchain');
    const result = document.getElementById('vresult');

    function buildCells(n: number): void {
      if (!chain) return;
      clearHTML(chain);
      const cols = 16;
      const total = Math.max(cols, Math.ceil(n / cols) * cols);
      for (let i = 0; i < total; i++) {
        const span = document.createElement('span');
        span.dataset.c = String(i);
        if (i >= n) span.classList.add('vis-hidden');
        chain.appendChild(span);
      }
    }

    buildCells(entryCountBoot || 64);

    async function loadJsonl(url: string): Promise<any[]> {
      const res = await fetch(url);
      if (!res.ok) throw new Error(`Failed to fetch ${url}: ${res.status}`);
      const text = await res.text();
      return text
        .split('\n')
        .map((l) => l.trim())
        .filter(Boolean)
        .map((l) => JSON.parse(l));
    }

    function toast(msg: string): void {
      const t = document.createElement('div');
      t.className = 'toast';
      t.setAttribute('role', 'status');
      t.textContent = msg;
      document.body.appendChild(t);
      setTimeout(() => t.remove(), 2200);
    }

    document.querySelectorAll('[data-act="copycli"]').forEach((el) => {
      el.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(fullCli);
          toast('Command copied');
        } catch {
          toast('Select the text and copy it');
        }
      });
    });

    let revealTimer = 0;

    function paintTiles(
      entries: { seq: number; event?: string }[],
      digestSeqs: Set<number>,
      count: number,
    ): void {
      if (!chain) return;
      const cells = chain.querySelectorAll('span');
      cells.forEach((cell, i) => {
        if (i >= entries.length) return;
        if (i < count) {
          const seq = entries[i]?.seq;
          cell.className = digestSeqs.has(seq) ? 'seal' : 'on';
        } else {
          cell.className = '';
        }
      });
    }

    btn?.addEventListener('click', async () => {
      if (!status || !btn || !chain || !result) return;
      if (revealTimer) window.clearInterval(revealTimer);
      revealTimer = 0;
      btn.disabled = true;
      clearHTML(result);
      chain.querySelectorAll('span').forEach((c) => {
        c.className = '';
      });

      if (!ed25519Available()) {
        status.textContent =
          'Ed25519 is not available in this browser. Use the CLI verifier below.';
        btn.disabled = false;
        return;
      }

      const reduce = revealImmediately(
        window.matchMedia('(prefers-reduced-motion: reduce)').matches,
      );

      try {
        status.textContent = 'Loading published log files…';
        const manifest = await fetch('/verify/manifest.json').then((r) => r.json());
        const entryLists = await Promise.all(
          (manifest.logFiles as string[]).map((f) => loadJsonl(f)),
        );
        const entries = entryLists.flat().sort((a, b) => a.seq - b.seq);
        const heads = await loadJsonl(manifest.headsFile);
        buildCells(entries.length);

        const digestSeqs = new Set(
          entries.filter((e) => e.event === 'observation_digest').map((e) => e.seq),
        );

        status.textContent = `Checking ${entries.length} entries…`;
        const verifyResult = await verifyLedger({
          entries,
          heads,
          pinnedPubkey: PINNED_PUBKEY,
          onProgress: (p) => {
            if (p.phase === 'chain') {
              if (reduce) status.textContent = `Checking entry ${p.done} of ${p.total}`;
            } else if (reduce) {
              status.textContent = `Checking signed heads (${p.done}/${p.total})…`;
            }
          },
        });

        const esc = (s: string) =>
          String(s).replace(/[&<>"']/g, (c) =>
            ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!,
          );
        const showLines = () => {
          setHTML(
            result,
            `<div class="rise mono u-082b7a2b">${verifyResult.lines.map((l) => esc(l)).join('<br>')}</div>`,
          );
        };

        if (!verifyResult.ok) {
          status.textContent = 'Verification failed. See details below.';
          showLines();
          btn.disabled = false;
          return;
        }

        const finishOk = () => {
          paintTiles(entries, digestSeqs, entries.length);
          status.textContent = 'Every hash matches. Every signature checks.';
          btn.textContent = 'Verify again';
          showLines();
          btn.disabled = false;
        };

        if (reduce) {
          finishOk();
          return;
        }

        let shown = 0;
        revealTimer = window.setInterval(() => {
          shown += 1;
          paintTiles(entries, digestSeqs, shown);
          status.textContent = `Checking entry ${shown} of ${entries.length}`;
          if (shown >= entries.length) {
            window.clearInterval(revealTimer);
            revealTimer = 0;
            finishOk();
          }
        }, TILE_REVEAL_MS);
      } catch (err) {
        status.textContent = `Could not complete verification: ${(err as Error).message}`;
        btn.disabled = false;
      }
    });
  </script>
</BaseLayout>
