---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteData } from '../data';
import { fmtLedgerAsOf } from '../lib/format';

const data = getSiteData();
const tipSeq = Math.max(0, data.chainLength - 1);
const updated = '2 October 2026';
---

<BaseLayout
  title="Privacy · Refledger"
  description="What Refledger collects about you, and what it does not."
  canonicalPath="/privacy"
  ledgerAsOf={fmtLedgerAsOf(data.buildTime)}
  ledgerAsOfIso={data.buildTime}
  latestSeq={tipSeq}
>
  <div class="wrap narrow u-882997a9">
    <h1 class="h1" tabindex="-1">Privacy</h1>
    <p class="lede u-aa1a1fba">
      Refledger is a free tool. This page says only what is true about how it
      handles visitor data today.
    </p>

    <section class="u-137cee62">
      <h2 class="h3">What this site collects</h2>
      <p class="u-9f210c88">
        Nothing of yours. There are no accounts, no cookies, no analytics, no
        tracking pixels, and no third-party scripts or fonts. Fonts are served
        from this site. The check of a repository runs entirely in your browser.
      </p>
    </section>

    <section class="u-e2147305">
      <h2 class="h3">What GitHub sees when you check a repo</h2>
      <p class="u-9f210c88">
        Your browser talks to GitHub's API directly. GitHub receives your IP
        address and the repository and actions you looked up, under
        <a
          href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement"
           rel="noopener noreferrer">GitHub's privacy statement</a
        >. Refledger never receives those requests, and never sees that IP
        address or those lookups.
      </p>
      <p class="u-9f210c88">
        If you paste a workflow file, the file itself never leaves your browser.
        Only the action names and tags inside it are sent to GitHub, so they can
        be resolved to commits.
      </p>
    </section>

    <section class="u-e2147305">
      <h2 class="h3">What Cloudflare sees</h2>
      <p class="u-9f210c88">
        This site is hosted on Cloudflare Pages. Cloudflare processes your IP
        address to serve the pages, under
        <a href="https://www.cloudflare.com/privacypolicy/"
           rel="noopener noreferrer">Cloudflare's privacy policy</a
        >. We do not run analytics on this site, and we do not keep our own
        visitor server logs.
      </p>
    </section>

    <section class="u-e2147305">
      <h2 class="h3">The ledger</h2>
      <p class="u-9f210c88">
        The public ledger records facts about public repositories: repository
        names, tag names, commit hashes, tree hashes, and times. It is
        append-only and permanent. It is built never to contain personal data
        such as tagger or commit author names and emails. If you believe an
        entry does contain personal data, contact us at
        <a href="mailto:developwith.gt@gmail.com" class="mono"
          >developwith.gt@gmail.com</a
        >.
      </p>
    </section>

    <p class="lbl u-c1105bdf">
      Last updated {updated}.
    </p>
  </div>
</BaseLayout>
