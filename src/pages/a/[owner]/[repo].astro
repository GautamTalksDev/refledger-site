---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TraceWall from '../../../components/TraceWall.astro';
import { getSiteData, shortSha, tagFromRef } from '../../../data';

export function getStaticPaths() {
  const data = getSiteData();
  return data.repos.map((r) => {
    const [owner, ...rest] = r.repo.split('/');
    return {
      params: { owner, repo: rest.join('/') },
      props: { repoKey: r.repo },
    };
  });
}

const { repoKey } = Astro.props;
const data = getSiteData();
const repo = data.reposByName.get(repoKey)!;
const events = data.traceEvents.filter((e) => e.repo === repoKey);
const [owner, name] = repoKey.split('/');
---

<BaseLayout
  title={`${repoKey} · Refledger`}
  description={`Tag binding history for ${repoKey}.`}
  canonicalPath={`/a/${repoKey}`}
  ogImage={`/og/a/${owner}/${name}.png`}
>
  <p class="muted">
    <a href="/actions">Actions</a> / <span class="mono">{repoKey}</span>
    {repo.canary && <span class="pill canary">Canary</span>}
  </p>
  <h1>{repoKey}</h1>
  <p class="lede">
    Watched since {repo.watched_since ?? 'unknown'}. Current tips below are from the newest Ok
    observation with peeled refs when available.
  </p>

  <section class="section">
    <h2>Pin these commits</h2>
    <div class="stack">
      {
        repo.tags.length === 0 ? (
          <p class="muted">No tags observed yet for this repository.</p>
        ) : (
          repo.tags.map((t) => {
            const tag = tagFromRef(t.ref);
            const tip = t.tip;
            if (!tip) {
              return (
                <div>
                  <p class="mono">{tag}</p>
                  <p class="muted">No current tip in the newest Ok observation.</p>
                </div>
              );
            }
            if (!tip.peeled || !tip.commit_sha) {
              return (
                <div>
                  <p class="mono">{tag}</p>
                  <p>
                    The commit has not been resolved yet (unpeeled tip{' '}
                    <span class="mono" title={tip.target_sha}>
                      {shortSha(tip.target_sha)}
                    </span>
                    ).
                  </p>
                </div>
              );
            }
            const line = `uses: ${repoKey}@${tip.commit_sha} # ${tag}`;
            return (
              <div class="pre-block">
                <button class="copy-btn" type="button" data-copy={line}>
                  Copy
                </button>
                <pre><code>{line}</code></pre>
              </div>
            );
          })
        )
      }
    </div>
  </section>

  <section class="section">
    <TraceWall
      idPrefix="repo-wall"
      showToolbar={false}
      buildTime={data.buildTime}
      genesisAt={data.genesisAt}
      wallRepos={[repoKey]}
      allRepos={[repo]}
      canary={repo.canary ? repo : null}
      events={events}
      seals={data.seals}
    />
  </section>

  <section class="section">
    <h2>Event history</h2>
    <div class="table-wrap">
      <table class="data">
        <thead>
          <tr>
            <th scope="col">Seq</th>
            <th scope="col">When</th>
            <th scope="col">Event</th>
            <th scope="col">Tag</th>
            <th scope="col">Detail</th>
          </tr>
        </thead>
        <tbody>
          {
            repo.entries
              .slice()
              .reverse()
              .map((e) => (
                <tr>
                  <td>
                    <a class="mono" href={`/e/${e.seq}`}>
                      {e.seq}
                    </a>
                  </td>
                  <td>{e.recorded_at}</td>
                  <td>{e.event}</td>
                  <td class="mono">
                    {'ref' in e && typeof e.ref === 'string' ? tagFromRef(e.ref) : ''}
                  </td>
                  <td>
                    <a href={`/e/${e.seq}`}>Open entry</a>
                  </td>
                </tr>
              ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <script is:inline>
    document.querySelectorAll('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-copy') || '';
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = 'Copied';
          setTimeout(() => {
            btn.textContent = 'Copy';
          }, 1500);
        } catch {
          btn.textContent = 'Copy failed';
        }
      });
    });
  </script>
</BaseLayout>
