---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TraceWall from '../../../components/TraceWall.astro';
import { getSiteData, shortSha, tagFromRef } from '../../../data';

export function getStaticPaths() {
  const data = getSiteData();
  return data.repos.map((r) => {
    const [owner, ...rest] = r.repo.split('/');
    return {
      params: { owner, repo: rest.join('/') },
      props: { repoKey: r.repo },
    };
  });
}

const { repoKey } = Astro.props;
const data = getSiteData();
const repo = data.reposByName.get(repoKey)!;
const events = data.traceEvents.filter((e) => e.repo === repoKey);
const [owner, name] = repoKey.split('/');
const pinned = repo.tags.filter((t) => t.tip?.pin_commit).length;
const tipCount = repo.tags.filter((t) => t.tip).length;
---

<BaseLayout
  title={`${repoKey} · Refledger`}
  description={`Tag binding history for ${repoKey}.`}
  canonicalPath={`/a/${repoKey}`}
  ogImage={`/og/a/${owner}/${name}.png`}
>
  <p class="muted">
    <a href="/actions">Actions</a> / <span class="mono">{repoKey}</span>
    {repo.canary && <span class="pill canary">Canary</span>}
  </p>
  <h1 style="font-size: clamp(1.6rem, 3vw, 34px); letter-spacing: -0.02em;">{repoKey}</h1>
  <p class="lede">
    Watched since {repo.watched_since ?? 'unknown'}. {repo.checks_so_far} checks so far.
    Last change {repo.last_change_at ?? 'none yet'}.
    {pinned} of {tipCount} current tips have a pin line.
  </p>

  <section class="section">
    <h2>Pin these commits</h2>
    <div class="stack">
      {
        tipCount === 0 ? (
          <p class="muted">No tags observed yet for this repository.</p>
        ) : (
          repo.tags.map((t) => {
            const tag = tagFromRef(t.ref);
            const tip = t.tip;
            if (!tip) {
              return (
                <div>
                  <p class="mono">{tag}</p>
                  <p class="muted">No current tip in the newest Ok observation.</p>
                </div>
              );
            }
            if (!tip.pin_commit) {
              return (
                <div>
                  <p class="mono">{tag}</p>
                  <p>
                    The commit has not been resolved yet (tip{' '}
                    <span class="mono" title={tip.target_sha}>
                      {shortSha(tip.target_sha)}
                    </span>
                    , {tip.ref_type}).
                  </p>
                </div>
              );
            }
            const line = `uses: ${repoKey}@${tip.pin_commit} # ${tag}`;
            return (
              <div class="pre-block">
                <button class="copy-btn" type="button" data-copy={line}>
                  Copy
                </button>
                <pre><code>{line}</code></pre>
              </div>
            );
          })
        )
      }
    </div>
  </section>

  <section class="section">
    <TraceWall
      idPrefix="repo-wall"
      showToolbar={false}
      buildTime={data.buildTime}
      genesisAt={data.genesisAt}
      wallRepos={repo.canary ? [] : [repoKey]}
      allRepos={[repo]}
      canary={repo.canary ? repo : null}
      events={events}
      seals={data.seals}
      gaps={data.gapBands.filter((g) => g.repos.includes(repoKey) || g.repos.length === 0)}
      correlations={data.correlationCaptions.filter((c) => c.repo === repoKey)}
    />
  </section>

  <section class="section">
    <h2>Event history</h2>
    <div class="table-wrap">
      <table class="data">
        <thead>
          <tr>
            <th scope="col">Seq</th>
            <th scope="col">When</th>
            <th scope="col">Event</th>
            <th scope="col">Tag</th>
            <th scope="col">Detail</th>
          </tr>
        </thead>
        <tbody>
          {
            repo.entries.length === 0 ? (
              <tr>
                <td colspan="5">
                  No ledger events yet. {repo.checks_so_far} observations are on record since{' '}
                  {repo.watched_since ?? 'watch start'}.
                </td>
              </tr>
            ) : (
              repo.entries
                .slice()
                .reverse()
                .map((e) => (
                  <tr>
                    <td>
                      <a class="mono" href={`/e/${e.seq}`}>
                        {e.seq}
                      </a>
                    </td>
                    <td>{e.recorded_at}</td>
                    <td>{e.event}</td>
                    <td class="mono">
                      {'ref' in e && typeof e.ref === 'string' ? tagFromRef(e.ref) : ''}
                    </td>
                    <td>
                      <a href={`/e/${e.seq}`}>Open entry</a>
                    </td>
                  </tr>
                ))
            )
          }
        </tbody>
      </table>
    </div>
  </section>

  <script is:inline>
    document.querySelectorAll('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-copy') || '';
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = 'Copied';
          setTimeout(() => {
            btn.textContent = 'Copy';
          }, 1500);
        } catch {
          btn.textContent = 'Copy failed';
        }
      });
    });
  </script>
</BaseLayout>
