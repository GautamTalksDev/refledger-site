---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getSiteData, shortSha, tagFromRef } from '../../../data';
import { buildAt } from '../../../lib/api-v1';
import { fmtLedgerAsOf, fmtUtc, agoFrom } from '../../../lib/format';

export function getStaticPaths() {
  const data = getSiteData();
  return data.repos.map((r) => {
    const [owner, ...rest] = r.repo.split('/');
    return {
      params: { owner, repo: rest.join('/') },
      props: { repoKey: r.repo },
    };
  });
}

const { repoKey } = Astro.props;
const data = getSiteData();
const repo = data.reposByName.get(repoKey)!;
const events = data.traceEvents.filter((e) => e.repo === repoKey);
const [owner] = repoKey.split('/');
const tipSeq = Math.max(0, data.chainLength - 1);
const nowMs = new Date(data.buildTime).getTime();
const movedTags = [
  ...new Set(
    events
      .filter((e) => e.event === 'move' || e.event === 'recreation')
      .map((e) => e.tag),
  ),
];
const latestMove = events.find(
  (e) => e.event === 'move' || e.event === 'recreation',
);
const watchedLabel = repo.watched_since
  ? fmtUtc(repo.watched_since).split(',')[0]
  : 'unknown';

const archiveTag =
  latestMove?.tag ??
  movedTags[0] ??
  (repo.tags.find((t) => t.tip?.commit_sha || t.tip?.target_sha)
    ? tagFromRef(
        repo.tags.find((t) => t.tip?.commit_sha || t.tip?.target_sha)!.ref,
      )
    : repo.tags[0]
      ? tagFromRef(repo.tags[0].ref)
      : null);
const archiveMove = latestMove;
const moments: {
  label: string;
  date: string;
  sha: string;
  note: string;
  window?: string;
  pressed?: boolean;
}[] = [];

function formatWindow(seconds: number | undefined): string | undefined {
  if (seconds == null || seconds <= 0) return undefined;
  if (seconds < 3600) return `Observation window: ${Math.round(seconds / 60)} minutes`;
  if (seconds < 86400)
    return `Observation window: ${(seconds / 3600).toFixed(1).replace(/\.0$/, '')} hours`;
  return `Observation window: ${(seconds / 86400).toFixed(1).replace(/\.0$/, '')} days`;
}

if (archiveTag && repo.watched_since) {
  const watchDate = repo.watched_since.slice(0, 10);
  const nowDate = data.buildTime.slice(0, 10);
  const atWatch = buildAt(watchDate, data);
  const atNow = buildAt(nowDate, data);
  const tip = repo.tags.find((t) => tagFromRef(t.ref) === archiveTag)?.tip;

  function shaAt(snap: ReturnType<typeof buildAt>, asOfDate: string): string {
    const b = snap.bindings.find(
      (x) => x.repo === repoKey && x.tag === archiveTag,
    );
    if (b && b.source !== 'absent' && (b.commit_sha || b.target_sha)) {
      return shortSha(b.commit_sha ?? b.target_sha ?? '');
    }
    // 304 Ok observations store no refs; fall back to the live tip when it
    // was already first-seen by asOfDate.
    if (!tip) return 'absent';
    const first = tip.first_observed?.slice(0, 10);
    if (first && first > asOfDate) return 'absent';
    return shortSha(tip.commit_sha ?? tip.target_sha ?? '');
  }

  moments.push({
    label: `${watchedLabel}, ${repo.watched_since.slice(11, 16)}`,
    date: watchDate,
    sha: shaAt(atWatch, watchDate),
    note: 'The first time we looked.',
  });

  if (archiveMove) {
    const moveDate = archiveMove.recorded_at.slice(0, 10);
    const entry = data.entriesBySeq.get(archiveMove.seq);
    const windowSecs =
      entry && 'observation_window_seconds' in entry
        ? entry.observation_window_seconds
        : undefined;
    const dayBefore = new Date(`${moveDate}T00:00:00.000Z`);
    dayBefore.setUTCDate(dayBefore.getUTCDate() - 1);
    const beforeDate = dayBefore.toISOString().slice(0, 10);
    moments.push({
      label: 'Before the move',
      date: beforeDate,
      sha: shortSha(archiveMove.fromCommit ?? archiveMove.fromTarget ?? ''),
      note: 'Unchanged.',
    });
    moments.push({
      label: fmtUtc(archiveMove.recorded_at),
      date: moveDate,
      sha: shaAt(buildAt(moveDate, data), moveDate),
      note: 'After the move was recorded.',
      window: formatWindow(
        typeof windowSecs === 'number' ? windowSecs : undefined,
      ),
    });
  }

  moments.push({
    label: 'Now',
    date: nowDate,
    sha: shaAt(atNow, nowDate),
    note: 'Current binding.',
    pressed: true,
  });
}
---

<BaseLayout
  title={`${repoKey} · Refledger`}
  description={`Tag binding history for ${repoKey}.`}
  canonicalPath={`/a/${repoKey}`}
  ogImage={`/og/a/${owner}/${repoKey.split('/')[1]}.png`}
  ledgerAsOf={fmtLedgerAsOf(data.lastCheckedAt)}
  ledgerAsOfIso={data.lastCheckedAt}
  latestSeq={tipSeq}
>
  <div class="wrap u-ed929bb2">
    <nav aria-label="Breadcrumb" class="lbl">
      <a class="u-1c9c449e" href="/moved">Watched actions</a> / {owner}
      {repo.canary && (
        <span class="pill u-5dd2a678">Canary</span>
      )}
    </nav>
    <h1
      class="h1 u-57fae8db"
      tabindex="-1"
     
    >
      {repoKey}
    </h1>
    <p class="lede u-c11c19bf">
      {
        movedTags.length && latestMove ? (
          <>
            Watched since {watchedLabel}. One or more tags have moved since
            then, including <b>{latestMove.tag}</b>,{' '}
            {(latestMove.whatChanged ?? latestMove.event).toLowerCase()} on{' '}
            {fmtUtc(latestMove.recorded_at).split(',')[0]}.
          </>
        ) : (
          <>
            Watched since {watchedLabel}. None of its tags have moved since
            then.
          </>
        )
      }
    </p>

    <dl
      class="ins u-b2405114"
     
    >
      <div class="u-45b0af64">
        <dt class="lbl">Watching since</dt>
        <dd class="u-84f4c591">
          {repo.watched_since ? `${fmtUtc(repo.watched_since)} UTC` : 'unknown'}
        </dd>
      </div>
      <div class="u-45b0af64">
        <dt class="lbl">Checked</dt>
        <dd class="u-84f4c591">
          Every 5 minutes ({repo.checks_so_far} so far)
        </dd>
      </div>
      <div class="u-45b0af64">
        <dt class="lbl">Last change</dt>
        <dd class="u-84f4c591">
          {repo.last_change_at
            ? `${fmtUtc(repo.last_change_at)} UTC`
            : 'None seen'}
        </dd>
      </div>
      <div class="u-45b0af64">
        <dt class="lbl">Upstream</dt>
        <dd class="u-84f4c591">
          <a
            href={`https://github.com/${encodeURIComponent(owner)}/${encodeURIComponent(repoKey.split('/')[1] ?? '')}`}
            rel="noopener noreferrer"
            >github.com/{repoKey}</a
          >
        </dd>
      </div>
    </dl>

    {
      movedTags.length > 0 ? (
        <section class="u-fa08ae21">
          <h2 class="h3">Pin it</h2>
          {repo.tags
            .filter((t) => movedTags.includes(tagFromRef(t.ref)) && t.tip?.pin_commit)
            .map((t) => {
              const tag = tagFromRef(t.ref);
              const pin = t.tip!.pin_commit!;
              const line = `uses: ${repoKey}@${pin} # ${tag}`;
              const move = events.find((e) => e.tag === tag);
              const age = move
                ? agoFrom(new Date(move.recorded_at).getTime(), nowMs)
                : null;
              return (
                <div class="u-1b0f4999">
                  <div
                    class="night row u-5baff73b"
                   
                  >
                    <span
                      class="mono u-66fe8c75"
                     
                    >
                      {line}
                    </span>
                    <button
                      type="button"
                      class="btn small u-a439c023"
                     
                      data-copy={line}
                    >
                      Copy
                    </button>
                  </div>
                  {age && (
                    <p class="lbl u-d2c171b1">
                      This binding is {age} old. {tag} is recorded in the
                      ledger and may move again.
                    </p>
                  )}
                </div>
              );
            })}
        </section>
      ) : (
        <section class="card u-fa08ae21">
          <div class="u-dbc9589a">
            <h2 class="h3">Nothing has moved</h2>
            <p class="u-df9b7173">
              Every tag of this action has pointed at the same commit at every
              check since we started watching. To lock that in for your
              workflow, <a href="/">check your repository</a> and copy the
              pinned lines.
            </p>
          </div>
        </section>
      )
    }

    {
      moments.length > 0 && archiveTag && (
        <section class="card u-fa08ae21">
          <div class="u-dbc9589a">
            <h2 class="h3">Ask the archive</h2>
            <p class="u-df9b7173">
              What did {archiveTag} point at, at a moment in the past? Only a record
              kept at the time can answer. Answers come from{' '}
              <a href={`/api/v1/at/${moments[moments.length - 1]?.date}.json`}
                ><code class="mono">/api/v1/at</code></a
              >{' '}
              and the binding history.
            </p>
            <div
              class="row u-c2ca0f5d"
             
              role="group"
              aria-label="Pick a moment"
              data-archive-moments
              data-repo={repoKey}
              data-tag={archiveTag}
            >
              {
                moments.map((m) => (
                  <button
                    type="button"
                    class={`btn small ${m.pressed ? 'b-ink' : 'b-line'}`}
                    data-act="moment"
                    data-date={m.date}
                    data-sha={m.sha}
                    data-note={m.note}
                    data-window={m.window || ''}
                    aria-pressed={m.pressed ? 'true' : 'false'}
                  >
                    {m.label}
                  </button>
                ))
              }
            </div>
            <div
              aria-live="polite"
              class="row u-0fb3d30d"
             
            >
              <span class="ins u-d3799af7">{archiveTag} pointed at</span>
              <span
                class="mono u-edd4855e"
                id="mo-sha"
               
                >{moments[moments.length - 1]?.sha}</span
              >
              <span class="ins muted u-433de30b" id="mo-note"
                >{moments[moments.length - 1]?.note}</span
              >
              <span class="ins muted u-433de30b" id="mo-window"
                >{moments[moments.length - 1]?.window || ''}</span
              >
            </div>
          </div>
        </section>
      )
    }

    {
      events.length > 0 && (
        <section class="u-fa08ae21">
          <h2 class="h3">History</h2>
          {events.map((m) => (
            <a
              href={`/a/${repoKey}/${m.tag}`}
              class="paper feedrow u-d6f2af6e"
             
            >
              <span class="ins u-433de30b">
                {fmtUtc(m.recorded_at)}
              </span>
              <span class="mono u-e3ec02ac">
                {m.tag}
              </span>
              <span class="u-d3799af7">
                {m.whatChanged ?? m.event}
              </span>
              <span class="mono u-5e0faad2">
                {m.fromToText ?? ''}
              </span>
              <span class="ins muted u-5e0faad2">
                Entry {m.seq}
              </span>
            </a>
          ))}
        </section>
      )
    }

    <p class="lbl u-49fcd855">
      This page says what moved and when. It never says whether an action is
      safe. That call is yours.
    </p>
  </div>

  <script>
    import '../../../scripts/archive-moments';
    document.querySelectorAll('[data-copy]').forEach((el) => {
      el.addEventListener('click', async () => {
        const text = el.getAttribute('data-copy') || '';
        try {
          await navigator.clipboard.writeText(text);
          const t = document.createElement('div');
          t.className = 'toast';
          t.setAttribute('role', 'status');
          t.textContent = 'Pinned line copied';
          document.body.appendChild(t);
          setTimeout(() => t.remove(), 2200);
        } catch {
          /* ignore */
        }
      });
    });
  </script>
</BaseLayout>
