---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { canonicalJson } from '../../lib/canonical';
import { getSiteData, effectiveDisplayClassification } from '../../data';
import { whatChangedFromEntry } from '../../lib/what-changed';

export function getStaticPaths() {
  const data = getSiteData();
  return data.entries.map((e) => ({
    params: { seq: String(e.seq) },
    props: { seq: e.seq },
  }));
}

const { seq } = Astro.props;
const data = getSiteData();
const entry = data.entriesBySeq.get(seq)!;
const { entry_hash, ...withoutHash } = entry as typeof entry & { entry_hash: string };
const rawCanonical = canonicalJson(withoutHash);
const correction = data.correctionsBySeq.get(seq) ?? null;
const display = whatChangedFromEntry(entry, correction);
const classification = effectiveDisplayClassification(entry, correction);
const prev = seq > 0 ? seq - 1 : null;
const next = seq + 1 < data.chainLength ? seq + 1 : null;

function sanitizeCopy(s: string): string {
  return s.replace(/\u2014/g, ',').replace(/\u2013/g, '-').replace(/--/g, ', ');
}
---

<BaseLayout
  title={`Entry seq ${seq} · Refledger`}
  description={`Ledger entry ${seq} (${entry.event}) recorded at ${entry.recorded_at}.`}
  canonicalPath={`/e/${seq}`}
>
  <p class="muted">
    <a href="/">Home</a> / entry <span class="mono">{seq}</span>
  </p>
  <h1>Entry seq {seq}</h1>
  <p class="lede">{entry.event} · {entry.recorded_at}</p>

  {
    correction && (
      <aside class="correction-note" role="note">
        <p>
          This entry has a signed correction at{' '}
          <a href={`/e/${correction.seq}`}>seq {correction.seq}</a>. Display uses the corrected
          facts; the original row stays in the chain for verification.
        </p>
        <p class="muted">{sanitizeCopy(correction.reason)}</p>
      </aside>
    )
  }

  {
    (entry.event === 'move' ||
      entry.event === 'deletion' ||
      entry.event === 'recreation') && (
      <p>
        <strong>What changed:</strong> {display.phrase}
        {
          display.fromTo.text && (
            <>
              {' '}
              (<span class="mono">{display.fromTo.text}</span>)
            </>
          )
        }
      </p>
    )
  }

  <p class="row">
    {
      prev !== null ? (
        <a href={`/e/${prev}`}>Previous (seq {prev})</a>
      ) : (
        <span class="muted">No previous</span>
      )
    }
    {
      next !== null ? (
        <a href={`/e/${next}`}>Next (seq {next})</a>
      ) : (
        <span class="muted">No next</span>
      )
    }
  </p>

  <section class="section">
    <h2>Fields</h2>
    <div class="table-wrap">
      <table class="data">
        <tbody>
          {
            Object.entries(entry).map(([k, v]) => {
              if (k === 'classification' && entry.event === 'deletion') return null;
              return (
                <tr>
                  <th scope="row">{k}</th>
                  <td>
                    <code class="mono"
                      >{typeof v === 'string'
                        ? sanitizeCopy(v)
                        : sanitizeCopy(JSON.stringify(v))}</code
                    >
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
    {
      entry.event === 'deletion' && (
        <p class="muted">
          Classification is omitted for deletions (see correction at seq 41 about seq 40).
        </p>
      )
    }
    {
      classification && (
        <p class="muted">
          Displayed classification: {classification}
          {
            correction &&
              'classification' in entry &&
              entry.classification !== classification && (
                <> (signed row had {(entry as { classification: string }).classification})</>
              )
          }
        </p>
      )
    }
  </section>

  <section class="section">
    <h2>Canonical JSON (without entry_hash)</h2>
    <div class="pre-block">
      <pre><code>{rawCanonical}</code></pre>
    </div>
    <p>
      Entry hash: <span class="mono">{entry_hash}</span>
    </p>
  </section>
</BaseLayout>
