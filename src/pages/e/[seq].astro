---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { canonicalJson } from '../../lib/canonical';
import { getSiteData, effectiveDisplayClassification, shortSha } from '../../data';
import { whatChangedFromEntry } from '../../lib/what-changed';
import { fmtLedgerAsOf, fmtUtc, titleCaseSeverity } from '../../lib/format';

export function getStaticPaths() {
  const data = getSiteData();
  return data.entries.map((e) => ({
    params: { seq: String(e.seq) },
    props: { seq: e.seq },
  }));
}

const { seq } = Astro.props;
const data = getSiteData();
const entry = data.entriesBySeq.get(seq)!;
const { entry_hash, ...withoutHash } = entry as typeof entry & {
  entry_hash: string;
};
const rawCanonical = canonicalJson(withoutHash);
const correction = data.correctionsBySeq.get(seq) ?? null;
const display = whatChangedFromEntry(entry, correction);
const classification = effectiveDisplayClassification(entry, correction);
const prev = seq > 0 ? seq - 1 : null;
const next = seq + 1 < data.chainLength ? seq + 1 : null;
const tipSeq = Math.max(0, data.chainLength - 1);

function sanitizeCopy(s: string): string {
  return s
    .replace(/\u2014/g, ',')
    .replace(/\u2013/g, '-')
    .replace(/--/g, ', ');
}

const isMove =
  entry.event === 'move' ||
  entry.event === 'deletion' ||
  entry.event === 'recreation';

const repo =
  'repo' in entry && typeof entry.repo === 'string' ? entry.repo : null;
const ref =
  'ref' in entry && typeof entry.ref === 'string' ? entry.ref : null;
const tag = ref ? ref.replace(/^refs\/tags\//, '') : null;

const facts: [string, string, boolean?][] = [
  ['Event', entry.event],
];
if ('severity' in entry && entry.severity) {
  facts.push(['Severity', titleCaseSeverity(String(entry.severity))]);
}
if (classification) {
  facts.push(['Classification', classification.replace(/_/g, ' ')]);
}
if ('ref_form' in entry && entry.ref_form) {
  facts.push(['Tag form', String(entry.ref_form).replace(/_/g, ' ')]);
}
if ('ancestry' in entry && entry.ancestry) {
  facts.push(['Direction', String(entry.ancestry).replace(/_/g, ' ')]);
}
if (isMove && entry.from) {
  facts.push([
    'From',
    shortSha(entry.from.commit_sha ?? entry.from.target_sha),
    true,
  ]);
}
if (isMove && entry.event !== 'deletion' && 'to' in entry && entry.to) {
  facts.push([
    'To',
    shortSha(entry.to.commit_sha ?? entry.to.target_sha),
    true,
  ]);
}
facts.push(['First seen', `${fmtUtc(entry.recorded_at)} UTC`]);
if (prev !== null) facts.push(['Chained to', `Entry ${prev}`]);

const headline =
  repo && tag
    ? `${repo} ${tag}`
    : entry.event;
---

<BaseLayout
  title={`Entry ${seq} · Refledger`}
  description={`Ledger entry ${seq} (${entry.event}) recorded at ${entry.recorded_at}.`}
  canonicalPath={`/e/${seq}`}
  ledgerAsOf={fmtLedgerAsOf(data.lastCheckedAt)}
  ledgerAsOfIso={data.lastCheckedAt}
  latestSeq={tipSeq}
>
  <div class="wrap u-ed929bb2">
    <div class="row u-a562f4fd">
      {
        prev !== null ? (
          <a href={`/e/${prev}`} class="btn b-line small">
            Entry {prev}
          </a>
        ) : (
          <span class="btn b-line small u-06a6aace"
            >Entry</span
          >
        )
      }
      <span class="lbl"
        >The ledger, entry {seq} of {data.chainLength}</span
      >
      {
        next !== null ? (
          <a href={`/e/${next}`} class="btn b-line small">
            Entry {next}
          </a>
        ) : (
          <span class="btn b-line small u-06a6aace"
            >Entry</span
          >
        )
      }
    </div>

    <div
      class="grid12 u-843aaf2f"
     
    >
      <section class="span6 u-fd9d635d">
        <div class="lbl">Entry</div>
        <h1
          class="mono u-443e6194"
          tabindex="-1"
         
        >
          {seq}
        </h1>
        <p class="u-f390bc86">
          {
            repo && tag ? (
              <a href={`/a/${repo}/${tag}`}>
                {headline}
              </a>
            ) : (
              headline
            )
          }
          {isMove ? ` ${display.phrase.toLowerCase()}.` : '.'}
        </p>
        {
          correction && (
            <aside
              class="ins u-078ffabe"
              role="note"
             
            >
              Corrected by{' '}
              <a href={`/e/${correction.seq}`}>entry {correction.seq}</a>.{' '}
              {sanitizeCopy(correction.reason)}
            </aside>
          )
        }
        <dl
          class="ins u-a98054a6"
         
        >
          {
            facts.map(([label, value, mono]) => (
              <div>
                <dt class="lbl">{label}</dt>
                <dd
                  class:list={['fact-dd', mono && 'mono', label === 'To' && 'to']}
                >
                  {value}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>
      <section
        class="span6 night u-d5b88bb5"
       
        aria-label="Canonical bytes"
      >
        <div class="lbl">Canonical JSON, abridged</div>
        <pre
          class="mono u-88434574"
         
          ><code
            >{rawCanonical.length > 1200
              ? rawCanonical.slice(0, 1200) + '…'
              : rawCanonical}</code
          ></pre
        >
        <p
          class="ins u-ee795180"
         
        >
          The SHA-256 of these bytes is this entry's hash ({shortSha(entry_hash.replace(/^sha256:/, ''), 8)}
          ). The next entry begins with it. Change one byte, and the chain
          breaks.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
