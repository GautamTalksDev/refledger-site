---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteData } from '../data';
import { fmtLedgerAsOf } from '../lib/format';
import { parseIncidentSummaries, renderPlainMarkdown } from '../lib/incidents';

const data = getSiteData();
const tipSeq = Math.max(0, data.chainLength - 1);
const incidents = parseIncidentSummaries(data.incidentSummariesMd);
if (!incidents.length) {
  throw new Error('docs/incident-summaries.md produced no incidents');
}
---

<BaseLayout
  title="Incidents · Refledger"
  description="Every mistake we have made, how we found it, and where we disclosed it."
  canonicalPath="/incidents"
  ledgerAsOf={fmtLedgerAsOf(data.lastCheckedAt)}
  ledgerAsOfIso={data.lastCheckedAt}
  latestSeq={tipSeq}
>
  <div class="wrap u-e47c4d83">
    <h1 class="h1" tabindex="-1">
      What went wrong,<br />on the record.
    </h1>
    <p class="lede u-f50a0c66">
      Every mistake we have made, how we found it, and where we disclosed it. We
      add to this list. We never remove from it. Most were caught by our own
      canary.
    </p>
    <ol class="incident-list">
      {
        incidents.map((x) => (
          <li class="paper incident">
            <p class="lbl nums">{x.when}</p>
            <h2 class="h3">{x.title}</h2>
            <p class="incident-body">
              {x.happened} {x.effect}
            </p>
            <p class="incident-changed">
              <span class="lbl">What changed. </span>
              {x.changed}
            </p>
            <details class="tech">
              <summary>Technical details</summary>
              <div class="md" set:html={renderPlainMarkdown(x.technical)} />
            </details>
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>
