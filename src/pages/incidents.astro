---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteData } from '../data';
import { fmtLedgerAsOf, fmtUtc } from '../lib/format';

const data = getSiteData();
const tipSeq = Math.max(0, data.chainLength - 1);

type IncidentRow = {
  when: string;
  title: string;
  what: string;
  response: string;
};

function parseIncidents(md: string): IncidentRow[] {
  const rows: IncidentRow[] = [];
  const lines = md.replace(/\r\n/g, '\n').split('\n');
  // Prefer markdown table rows if present
  for (let i = 0; i < lines.length; i++) {
    if (!lines[i].startsWith('|')) continue;
    if (!lines[i + 1]?.match(/^\|[\s-:|]+$/)) continue;
    i += 2;
    while (i < lines.length && lines[i].startsWith('|')) {
      const cells = lines[i]
        .split('|')
        .slice(1, -1)
        .map((c) =>
          c
            .trim()
            .replace(/\u2014/g, ',')
            .replace(/\u2013/g, '-')
            .replace(/--/g, ', '),
        );
      if (cells.length >= 4) {
        rows.push({
          when: cells[0],
          title: cells[1],
          what: cells[2],
          response: cells[3],
        });
      }
      i++;
    }
  }
  if (rows.length) return rows;

  // Fall back: ## headings as titles, following paragraphs as body
  let current: IncidentRow | null = null;
  for (const line of lines) {
    if (line.startsWith('## ')) {
      if (current) rows.push(current);
      current = {
        when: '',
        title: line
          .slice(3)
          .replace(/\u2014/g, ',')
          .replace(/\u2013/g, '-')
          .replace(/--/g, ', '),
        what: '',
        response: '',
      };
      continue;
    }
    if (!current || !line.trim()) continue;
    if (!current.what) current.what = line.trim();
    else if (!current.response) current.response = line.trim();
  }
  if (current) rows.push(current);
  return rows;
}

const fromMd = parseIncidents(data.incidentsMd);
const digestNotes = data.digests
  .filter((d) => d.observation_digest.note)
  .map((d) => ({
    when: fmtUtc(d.recorded_at).split(',')[0],
    title: `Digest note, entry ${d.seq}`,
    what: d.observation_digest.note!,
    response: 'Disclosed in the signed observation digest.',
  }));

const incidents: IncidentRow[] = [...fromMd];
for (const n of digestNotes) {
  if (!incidents.some((r) => r.what === n.what)) incidents.push(n);
}
---

<BaseLayout
  title="Incidents · Refledger"
  description="Every mistake we have made, how we found it, and where we disclosed it."
  canonicalPath="/incidents"
  ledgerAsOf={fmtLedgerAsOf(data.buildTime)}
  latestSeq={tipSeq}
>
  <div class="wrap" style="padding-top:72px">
    <h1 class="h1" tabindex="-1">
      What went wrong,<br />on the record.
    </h1>
    <p class="lede" style="margin-top:22px;max-width:660px">
      Every mistake we have made, how we found it, and where we disclosed it. We
      add to this list. We never remove from it. Most were caught by our own
      canary.
    </p>
    <ol
      style="margin:52px 0 0;padding:0;list-style:none;display:flex;flex-direction:column;gap:10px"
    >
      {
        incidents.map((x) => (
          <li
            class="paper grid12"
            style="gap:18px;padding:22px 24px;align-items:start"
          >
            <span
              class="ins"
              style="grid-column:span 2;font-size:14px;color:var(--ink2)"
            >
              {x.when || 'Noted'}
            </span>
            <span style="grid-column:span 3;font-weight:800;line-height:1.35">
              {x.title}
            </span>
            <span style="grid-column:span 4;color:var(--ink2)">{x.what}</span>
            <span
              class="ins"
              style="grid-column:span 3;font-size:13.5px;color:var(--ink3)"
            >
              {x.response}
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>
