---
import BaseLayout from '../layouts/BaseLayout.astro';
import LookupForm from '../components/LookupForm.astro';
import { getSiteData } from '../data';

const q = (Astro.url.searchParams.get('q') || '').trim();
const data = getSiteData();

let redirectTo: string | null = null;
const matches = data.repos.filter((r) => {
  const needle = q.toLowerCase();
  if (!needle) return false;
  return r.repo.toLowerCase().includes(needle);
});

if (matches.length === 1 && matches[0].repo.toLowerCase() === q.toLowerCase()) {
  redirectTo = `/a/${matches[0].repo}`;
} else if (matches.length === 1) {
  redirectTo = `/a/${matches[0].repo}`;
}

if (redirectTo) {
  return Astro.redirect(redirectTo);
}
---

<BaseLayout
  title={q ? `Search: ${q} · Refledger` : 'Search · Refledger'}
  description="Look up a watched GitHub Action in the Refledger population."
  canonicalPath="/search"
>
  <h1>Search</h1>
  <LookupForm value={q} />
  {
    q && (
      <section class="section">
        <h2>Results for {q}</h2>
        {matches.length === 0 ? (
          <p>No watched repository matched.</p>
        ) : (
          <ul>
            {matches.map((m) => (
              <li>
                <a href={`/a/${m.repo}`}>{m.repo}</a>
                {m.canary && <span class="pill canary">Canary</span>}
              </li>
            ))}
          </ul>
        )}
      </section>
    )
  }
</BaseLayout>
