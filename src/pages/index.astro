---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteData } from '../data';
import { agoFrom, fmtLedgerAsOf } from '../lib/format';

const data = getSiteData();
const nowMs = new Date(data.buildTime).getTime();
const eco = data.traceEvents.filter((e) => !e.isCanary);
const latest = eco[0]
  ? {
      repo: eco[0].repo,
      tag: eco[0].tag,
      what: eco[0].whatChanged ?? eco[0].event,
      ago: agoFrom(new Date(eco[0].recorded_at).getTime(), nowMs),
    }
  : null;
const tipSeq = Math.max(0, data.chainLength - 1);
---

<BaseLayout
  title="Refledger: is your workflow running the code you think it is?"
  description="Refledger checks every GitHub Action your workflow uses, tells you which ones can change without you knowing, and gives you the fix. Backed by a public, signed record of where every watched tag has pointed."
  canonicalPath="/"
  nav="home"
  ledgerAsOf={fmtLedgerAsOf(data.buildTime)}
  latestSeq={tipSeq}
>
  <div class="wrap narrow" style="padding-top:88px">
    <h1 class="h1" tabindex="-1">
      Is your workflow running the code you think it is?
    </h1>
    <p class="lede" style="margin-top:24px;max-width:640px">
      Enter a public GitHub repository. We check every action it uses, tell you
      which ones can change without you knowing, and give you the fix.
    </p>
    <form class="bigform" style="margin-top:40px" action="/check" method="get">
      <label for="repo" class="lbl" style="flex-basis:100%">Repository</label>
      <input
        id="repo"
        name="repo"
        type="text"
        placeholder="your-org/your-repo"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        required
      />
      <button type="submit" class="btn b-blue">Check</button>
    </form>
    <p class="ins muted" style="margin-top:14px;font-size:13.5px">
      Runs in your browser. Nothing is stored.
      <a href="/paste" class="linkbtn" style="text-decoration:underline"
        >Paste a workflow instead</a
      >
      or
      <a href="/check?example=1" class="linkbtn" style="text-decoration:underline"
        >try an example</a
      >.
    </p>

    <div class="card" style="margin-top:96px;padding:28px 30px">
      <div
        class="row"
        style="justify-content:space-between;align-items:flex-start;gap:24px"
      >
        <div style="max-width:560px">
          <h2 class="h3">Why this matters</h2>
          <p style="margin:8px 0 0;color:var(--ink2)">
            A tag like <span class="mono">@v4</span> is a pointer. Its owner, or
            anyone who takes over their account, can point it at different code
            tonight. Your workflow file won't change, and your next run will
            execute it. In March 2025, 346 tags of tj-actions/changed-files were
            moved this way.
          </p>
        </div>
        <a href="/how" class="btn b-line">See it happen</a>
      </div>
    </div>

    {
      latest && (
        <div style="margin-top:40px" class="row">
          <span class="lbl">Latest real move:</span>
          <a
            href={`/a/${latest.repo}/${latest.tag}`}
            style="font-size:15px"
          >
            {latest.repo} {latest.tag} {latest.what.toLowerCase()}, {latest.ago}{' '}
            ago
          </a>
        </div>
      )
    }
  </div>
</BaseLayout>
