---
import '../styles/base.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  /** Which main nav item is current: home | moved | how | verify */
  nav?: 'home' | 'moved' | 'how' | 'verify' | null;
  ledgerAsOf?: string;
  /** Latest tip seq for footer example link */
  latestSeq?: number;
  exampleAction?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname.replace(/\/$/, '') || '/',
  ogImage = '/og/default.png',
  nav = null,
  ledgerAsOf,
  latestSeq,
  exampleAction = 'reviewdog/action-actionlint',
} = Astro.props;

const site = 'https://refledger.gautamkhosla.com';
const canonical = `${site}${canonicalPath === '/' ? '' : canonicalPath}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${site}${ogImage}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="wrap in">
        <a href="/" class="logo" aria-label="Refledger home">
          <svg
            width="28"
            height="20"
            viewBox="0 0 28 20"
            aria-hidden="true"
            fill="none"
            stroke-width="2.2"
            stroke-linecap="round"
          >
            <path d="M2 4 H26" stroke="currentColor"></path>
            <path d="M2 10 H13 V16 H26" stroke="var(--blue)"></path>
          </svg>
          Refledger
        </a>
        <nav class="main" aria-label="Main">
          <a href="/" aria-current={nav === 'home' ? 'page' : undefined}
            >Check a repo</a
          >
          <a href="/moved" aria-current={nav === 'moved' ? 'page' : undefined}
            >What moved</a
          >
          <a href="/how" aria-current={nav === 'how' ? 'page' : undefined}
            >How it works</a
          >
          <a href="/verify" aria-current={nav === 'verify' ? 'page' : undefined}
            >Verify</a
          >
        </nav>
        {
          ledgerAsOf && (
            <span class="status" title="The most recent data in this build">
              <span class="dot" aria-hidden="true"></span>
              Ledger as of {ledgerAsOf}
            </span>
          )
        }
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap in">
        <span>Refledger records facts, never verdicts.</span>
        <nav aria-label="Footer">
          <a href="/how">How it works</a>
          <a href="/incidents">Incidents</a>
          <a href={`/a/${exampleAction}`}>Example action</a>
          {
            latestSeq != null && (
              <a href={`/e/${latestSeq}`}>Latest entry</a>
            )
          }
          <a href="https://github.com/GautamTalksDev/refledger">Source</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
