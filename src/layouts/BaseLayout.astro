---
import '../styles/base.css';
import '../styles/utilities.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  /** Which main nav item is current: home | moved | how | verify */
  nav?: 'home' | 'moved' | 'how' | 'verify' | null;
  /** Formatted chip label, e.g. "2 Oct, 16:20 UTC", from build-time data only. */
  ledgerAsOf?: string;
  /** ISO timestamp for the chip; used only to decide the stale notice client-side. */
  ledgerAsOfIso?: string;
  /** Latest tip seq for footer example link */
  latestSeq?: number;
  exampleAction?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname.replace(/\/$/, '') || '/',
  ogImage = '/og/default.png',
  nav = null,
  ledgerAsOf,
  ledgerAsOfIso,
  latestSeq,
  exampleAction = 'reviewdog/action-actionlint',
} = Astro.props;

const site = 'https://refledger.gautamkhosla.com';
const canonical = `${site}${canonicalPath === '/' ? '' : canonicalPath}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${site}${ogImage}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/fonts/schibsted-grotesk-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/b612-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="wrap in">
        <a href="/" class="logo" aria-label="Refledger home">
          <svg
            width="28"
            height="20"
            viewBox="0 0 28 20"
            aria-hidden="true"
            fill="none"
            stroke-width="2.2"
            stroke-linecap="round"
          >
            <path d="M2 4 H26" stroke="currentColor"></path>
            <path d="M2 10 H13 V16 H26" stroke="var(--blue)"></path>
          </svg>
          Refledger
        </a>
        <nav class="main" aria-label="Main">
          <a href="/" aria-current={nav === 'home' ? 'page' : undefined}
            >Check a repo</a
          >
          <a href="/moved" aria-current={nav === 'moved' ? 'page' : undefined}
            >What moved</a
          >
          <a href="/how" aria-current={nav === 'how' ? 'page' : undefined}
            >How it works</a
          >
          <a href="/verify" aria-current={nav === 'verify' ? 'page' : undefined}
            >Verify</a
          >
        </nav>
        {
          ledgerAsOf && (
            <span
              class="status"
              title="Snapshot time from the ledger data in this build"
              data-ledger-as-of={ledgerAsOfIso ?? undefined}
              data-ledger-label={ledgerAsOf}
            >
              <span class="dot" aria-hidden="true"></span>
              Ledger as of {ledgerAsOf}
            </span>
          )
        }
      </div>
      <p
        class="wrap stale-notice"
        id="stale-notice"
        hidden
        role="status"
        aria-live="polite"
      ></p>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap in">
        <span>Refledger records facts, never verdicts.</span>
        <nav aria-label="Footer">
          <a href="/how">How it works</a>
          <a href="/incidents">Incidents</a>
          <a href="/privacy">Privacy</a>
          <a href="/security">Security</a>
          <a href={`/a/${exampleAction}`}>Example action</a>
          {
            latestSeq != null && (
              <a href={`/e/${latestSeq}`}>Latest entry</a>
            )
          }
          <a
            href="https://github.com/GautamTalksDev/refledger"
            rel="noopener noreferrer">Source</a
          >
        </nav>
      </div>
    </footer>
    {
      ledgerAsOf && ledgerAsOfIso && (
        <script>
          import { bootFreshnessNotice } from '../scripts/freshness-boot';
          bootFreshnessNotice();
        </script>
      )
    }
  </body>
</html>
