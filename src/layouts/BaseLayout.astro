---
import '../styles/base.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname.replace(/\/$/, '') || '/',
  ogImage = '/og/default.png',
} = Astro.props;

const site = 'https://refledger.gautamkhosla.com';
const canonical = `${site}${canonicalPath === '/' ? '' : canonicalPath}`;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${site}${ogImage}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="site-shell header-inner">
        <a class="wordmark" href="/" aria-label="Refledger home">
          <svg width="30" height="22" viewBox="0 0 30 22" aria-hidden="true" fill="none" stroke-width="2.2" stroke-linecap="round">
            <path d="M2 5 H28" stroke="currentColor"></path>
            <path d="M2 11 H14 V17 H28" stroke="var(--accent)"></path>
          </svg>
          <span class="wordmark-text">Refledger</span>
        </a>
        <nav aria-label="Main">
          <ul class="site-nav">
            <li>
              <a href="/moved" aria-current={path.startsWith('/moved') ? 'page' : undefined}
                >Moved</a
              >
            </li>
            <li>
              <a
                href="/actions"
                aria-current={path.startsWith('/actions') || path.startsWith('/a/')
                  ? 'page'
                  : undefined}>Actions</a
              >
            </li>
            <li>
              <a href="/verify" aria-current={path.startsWith('/verify') ? 'page' : undefined}
                >Verify</a
              >
            </li>
            <li>
              <a
                href="/why-pinning-tags-does-not-work"
                aria-current={path.startsWith('/why-pinning') ? 'page' : undefined}
                >Why tags move</a
              >
            </li>
            <li>
              <a class="nav-source" href="https://github.com/GautamTalksDev/refledger"
                >Source on GitHub</a
              >
            </li>
          </ul>
        </nav>
      </div>
    </header>
    <main class="site-main site-shell">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-shell footer-inner">
        <span>Refledger records facts, never verdicts. Code under Apache 2.0.</span>
        <span>Public key, crawler policy and kill test are on GitHub.</span>
      </div>
    </footer>
  </body>
</html>
