---
/** Command palette shell; behaviour in deferred script. */
import { getSiteData } from '../data';

const data = getSiteData();
const items: { label: string; href: string; group: string }[] = [
  { label: 'Home', href: '/', group: 'Pages' },
  { label: 'Actions', href: '/actions', group: 'Pages' },
  { label: 'Moved', href: '/moved', group: 'Pages' },
  { label: 'Verify', href: '/verify', group: 'Pages' },
  { label: 'Pin my workflow', href: '/pin', group: 'Pages' },
  { label: 'API docs', href: '/docs/api', group: 'Pages' },
  { label: 'Incidents', href: '/incidents', group: 'Pages' },
];

for (const r of data.repos) {
  items.push({ label: r.repo, href: `/a/${r.repo}`, group: 'Actions' });
}
for (const e of data.traceEvents.slice(0, 60)) {
  items.push({
    label: `${e.repo}@${e.tag} seq ${e.seq}`,
    href: `/e/${e.seq}`,
    group: 'Entries',
  });
}
for (const e of data.entries.filter((x) => x.event === 'correction' || x.event === 'observation_digest').slice(-20)) {
  items.push({
    label: `seq ${e.seq} (${e.event})`,
    href: `/e/${e.seq}`,
    group: 'Entries',
  });
}
---

<dialog id="cmdk" class="cmdk-dialog-el" aria-label="Jump to">
  <div class="cmdk-dialog">
    <input id="cmdk-input" type="search" placeholder="Jump to action, tag, seq, or page" autocomplete="off" />
    <ul id="cmdk-list" class="cmdk-list" role="listbox"></ul>
  </div>
</dialog>

<script type="application/json" id="cmdk-data" set:html={JSON.stringify(items)} />

<script>
  const dialog = document.getElementById('cmdk') as HTMLDialogElement | null;
  const input = document.getElementById('cmdk-input') as HTMLInputElement | null;
  const list = document.getElementById('cmdk-list');
  const raw = document.getElementById('cmdk-data')?.textContent || '[]';
  const items = JSON.parse(raw) as { label: string; href: string; group: string }[];

  function render(q: string) {
    if (!list) return;
    const qq = q.trim().toLowerCase();
    const hits = items
      .filter((i) => !qq || i.label.toLowerCase().includes(qq) || i.href.includes(qq))
      .slice(0, 40);
    list.innerHTML = hits
      .map(
        (h) =>
          `<li role="option"><a href="${h.href}"><span class="muted">${h.group}</span> · ${h.label}</a></li>`,
      )
      .join('');
  }

  function open() {
    if (!dialog || !input) return;
    render('');
    dialog.showModal();
    input.value = '';
    input.focus();
  }

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (dialog?.open) dialog.close();
      else open();
    }
  });

  input?.addEventListener('input', () => render(input.value));
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>

<style>
  .cmdk-dialog-el {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: none;
  }
  .cmdk-dialog-el::backdrop {
    background: color-mix(in srgb, #000 45%, transparent);
  }
</style>
