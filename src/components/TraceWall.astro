---
import { buildWallModel, renderWallSvg, wallTableRows, type WallRange } from '../lib/wall';
import type { CorrelationCaption, TraceEvent } from '../data';
import type { GapBand } from '../data/gaps';
import type { RepoView, Seal } from '../data';

interface Props {
  range?: WallRange;
  buildTime: string;
  genesisAt: string;
  wallRepos: string[];
  allRepos: RepoView[];
  canary: RepoView | null;
  events: TraceEvent[];
  seals: Seal[];
  gaps: GapBand[];
  correlations: CorrelationCaption[];
  idPrefix?: string;
  showToolbar?: boolean;
}

const {
  range = 'genesis',
  buildTime,
  genesisAt,
  wallRepos,
  allRepos,
  canary,
  events,
  seals,
  gaps,
  correlations,
  idPrefix = 'wall',
  showToolbar = true,
} = Astro.props;

const ranges: WallRange[] = ['genesis', '7d', '30d'];
const models = Object.fromEntries(
  ranges.map((r) => [
    r,
    buildWallModel({
      range: r,
      buildTime,
      genesisAt,
      wallRepos,
      allRepos,
      canary,
      events,
      seals,
      gaps,
      correlations,
    }),
  ]),
) as Record<WallRange, ReturnType<typeof buildWallModel>>;

const active = models[range];
const tableRows = wallTableRows(active);
---

<section class="wall-panel" aria-labelledby={`${idPrefix}-heading`}>
  <div class="wall-panel-header">
    <div>
      <h2 id={`${idPrefix}-heading`}>Every watched tag since genesis</h2>
      <p class="wall-panel-sub">One line per repository. A straight line means nothing moved.</p>
    </div>
    {
      showToolbar && (
        <div class="wall-range" role="group" aria-label="Time range">
          {ranges.map((r) => (
            <button
              type="button"
              data-wall-range={r}
              aria-pressed={r === range ? 'true' : 'false'}
            >
              {r === 'genesis' ? 'Since genesis' : r === '7d' ? '7 days' : '30 days'}
            </button>
          ))}
        </div>
      )
    }
  </div>

  <div class="wall-svg-scroll">
    {
      ranges.map((r) => (
        <div
          class="wall-svg-slot"
          data-range={r}
          hidden={r !== range}
          set:html={renderWallSvg(models[r])}
        />
      ))
    }
  </div>

  <div class="wall-legend">
    <span>
      <svg width="26" height="10" aria-hidden="true"
        ><line x1="1" y1="5" x2="25" y2="5" stroke="currentColor" stroke-width="1.6"></line></svg
      >
      Unchanged
    </span>
    <span>
      <svg width="26" height="12" aria-hidden="true"
        ><path
          d="M1 3 H12 V9 H25"
          stroke="var(--accent)"
          stroke-width="2"
          fill="none"></path></svg
      >
      Tag moved
    </span>
    <span>
      <svg width="26" height="10" aria-hidden="true"
        ><line x1="1" y1="5" x2="18" y2="5" stroke="currentColor" stroke-width="1.6"></line><circle
          cx="20"
          cy="5"
          r="3"
          fill="var(--surface)"
          stroke="currentColor"
          stroke-width="1.4"></circle></svg
      >
      Tag deleted
    </span>
    <span>
      <svg width="26" height="12" aria-hidden="true"
        ><rect x="1" y="1" width="24" height="10" fill="url(#gapHatch)" stroke="#C9D1CD"></rect></svg
      >
      Recorded gap (skipped or failed)
    </span>
    <span>
      <svg width="26" height="12" aria-hidden="true"
        ><rect
          x="1"
          y="1"
          width="24"
          height="10"
          fill="transparent"
          stroke="#9AA6A2"
          stroke-dasharray="3 3"></rect></svg
      >
      No checks seen
    </span>
    <span>
      <svg width="14" height="14" aria-hidden="true"
        ><rect
          x="3"
          y="3"
          width="8"
          height="8"
          transform="rotate(45 7 7)"
          fill="currentColor"></rect></svg
      >
      Day sealed and witnessed
    </span>
  </div>

  <p class="wall-table-link">
    <a href={`#${idPrefix}-table`}>View as table</a>
  </p>

  <div id={`${idPrefix}-table`} class="table-wrap wall-table">
    <table class="data">
      <caption class="sr-only">Trace wall events as a table</caption>
      <thead>
        <tr>
          <th scope="col">Repository</th>
          <th scope="col">Tag</th>
          <th scope="col">Event</th>
          <th scope="col">Recorded at</th>
          <th scope="col">Entry</th>
        </tr>
      </thead>
      <tbody>
        {
          tableRows.length === 0 ? (
            <tr>
              <td colspan="5">No tag movements in this range.</td>
            </tr>
          ) : (
            tableRows.map((row) => (
              <tr>
                <td>
                  <a href={`/a/${row.repo}`}>{row.repo}</a>
                </td>
                <td class="mono">{row.tag}</td>
                <td>{row.event}</td>
                <td>{row.at}</td>
                <td>
                  <a class="mono" href={`/e/${row.seq}`}>
                    seq {row.seq}
                  </a>
                </td>
              </tr>
            ))
          )
        }
      </tbody>
    </table>
  </div>
</section>

{
  showToolbar && (
    <script is:inline>
      (() => {
        const root = document.currentScript?.previousElementSibling?.previousElementSibling
          ? null
          : null;
        const panel = document.querySelector('.wall-panel');
        if (!panel) return;
        const buttons = panel.querySelectorAll('[data-wall-range]');
        const slots = panel.querySelectorAll('.wall-svg-slot');
        buttons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const range = btn.getAttribute('data-wall-range');
            buttons.forEach((b) =>
              b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'),
            );
            slots.forEach((slot) => {
              slot.hidden = slot.getAttribute('data-range') !== range;
            });
          });
        });
      })();
    </script>
  )
}
