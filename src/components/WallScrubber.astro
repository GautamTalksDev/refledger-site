---
interface Props {
  buildTime: string;
  dates: string[];
}

const { buildTime, dates } = Astro.props;
const sorted = [...dates].sort();
---

<div
  class="wall-scrubber"
  data-scrubber
  data-dates={sorted.join(',')}
  data-build={buildTime}
>
  <label for="wall-scrub">
    Time cursor
    <span id="scrub-label" class="mono">{sorted[sorted.length - 1] ?? '—'}</span>
  </label>
  <input
    id="wall-scrub"
    type="range"
    min="0"
    max={Math.max(0, sorted.length - 1)}
    value={Math.max(0, sorted.length - 1)}
    step="1"
    aria-valuetext={sorted[sorted.length - 1] ?? ''}
  />
  <div id="scrub-live" class="wall-scrubber-readout" aria-live="polite"></div>
</div>

<script>
  const root = document.querySelector('[data-scrubber]') as HTMLElement | null;
  if (root) {
    const dates = (root.getAttribute('data-dates') || '').split(',').filter(Boolean);
    const input = root.querySelector('#wall-scrub') as HTMLInputElement;
    const label = root.querySelector('#scrub-label')!;
    const live = root.querySelector('#scrub-live')!;
    const cache = new Map<string, any>();

    async function load(date: string) {
      if (cache.has(date)) return cache.get(date);
      const res = await fetch(`/api/v1/at/${date}.json`);
      if (!res.ok) throw new Error('at snapshot missing');
      const json = await res.json();
      cache.set(date, json);
      return json;
    }

    async function update() {
      const idx = Number(input.value);
      const date = dates[idx];
      if (!date) return;
      label.textContent = date;
      input.setAttribute('aria-valuetext', date);
      live.textContent = 'Loading bindings…';
      try {
        const snap = await load(date);
        const sample = (snap.bindings as any[])
          .filter((b) => b.commit_sha)
          .slice(0, 24)
          .map(
            (b) =>
              `${b.repo}@${b.tag} → ${(b.commit_sha as string).slice(0, 7)} (${b.source})`,
          )
          .join('\n');
        live.textContent =
          sample || `No resolved bindings in snapshot for ${date}.`;
      } catch {
        live.textContent = `Could not load /api/v1/at/${date}.json`;
      }
    }

    input.addEventListener('input', () => {
      void update();
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
        // native range already moves; force readout refresh after
        requestAnimationFrame(() => void update());
      }
    });
    void update();
  }
</script>
