---
interface Props {
  action?: string;
  value?: string;
}
const { action = '/search', value = '' } = Astro.props;
---

<form class="lookup-form" action={action} method="get" role="search">
  <label class="sr-only" for="repo-lookup">Look up a watched action</label>
  <input
    id="repo-lookup"
    name="q"
    type="search"
    placeholder="owner/repo"
    value={value}
    autocomplete="off"
    list="watched-repos"
    required
  />
  <button type="submit">Look up</button>
</form>
