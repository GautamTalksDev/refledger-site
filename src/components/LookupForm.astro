---
interface Props {
  action?: string;
  value?: string;
}
const { action = '/search', value = '' } = Astro.props;
---

<form class="lookup-form" action={action} method="get" role="search">
  <label for="repo-lookup">Look up an action</label>
  <div class="lookup-row">
    <input
      id="repo-lookup"
      name="q"
      type="search"
      placeholder="actions/checkout"
      value={value}
      autocomplete="off"
      list="watched-repos"
      required
    />
    <button type="submit">Look up</button>
  </div>
</form>
